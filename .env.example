# Acesso ao painel
APP_USERNAME=admin
APP_PASSWORD=troque-por-uma-senha-forte
AUTH_SECRET=gere-uma-chave-longa-e-aleatoria

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Servidor e agendador
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
SCHEDULER_INTERVAL_MS=15000

# Opcional: caminho do Chrome/Chromium na VPS
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
